# --- SliceMatic frontend (Vite) config -------------------------------------
# Copy to .env.local for local dev; set the same var in Vercel for production.

# Base URL of the SliceMatic API (the FastAPI backend).
#   Local dev : http://localhost:8000
#   Production: https://<your-api-host>   (e.g. Render/Railway URL)
# Empty string = same origin (only correct if the API is served on the same host).
VITE_API_URL=http://localhost:8000
