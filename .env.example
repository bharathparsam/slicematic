# --- SliceMatic frontend (Vite) config -------------------------------------
# Copy to .env.local for local dev.
# On Vercel: Project → Settings → Environment Variables — set all three vars below.

# Base URL of the SliceMatic API (the FastAPI backend).
#   Local dev : leave unset or http://localhost:8000 (Vite proxies /api in dev)
#   Vercel    : https://<your-api-host>  (Render/Railway/etc. — no trailing slash)
# Empty string = same origin (only if API is served on the same host as the SPA).
VITE_API_URL=http://localhost:8000

# --- Supabase Auth (Admin portal sign-in) ----------------------------------
# From Supabase → Project Settings → API. The anon key is safe in the browser —
# access is governed by Supabase Auth + Row Level Security, not by hiding it.
# Admin users are created in Supabase → Authentication → Users.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# COO chat + daily briefing call the backend API only. Set OPENROUTER_API_KEY on
# the FastAPI host (see backend/.env.example) — never in Vite env vars.
