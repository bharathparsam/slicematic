{
  "name": "slicematic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "api:setup": "cd backend && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "api": "cd backend && .venv/bin/python -m uvicorn main:app --reload --port 8000",
    "api:test": "cd backend && .venv/bin/python -m pytest",
    "seed:demo": "cd backend && .venv/bin/python ../scripts/seed_demo_data.py",
    "seed:demo:reset": "cd backend && .venv/bin/python ../scripts/seed_demo_data.py --reset --orders 80 --days 14 --active 8 --verify-analytics",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:local:init": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -f sql/schema.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.0",
    "vitest": "^4.1.9"
  }
}
