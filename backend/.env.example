# --- SliceMatic backend (FastAPI) config -----------------------------------
# Copy to backend/.env and fill in your Supabase values.

# Supabase Postgres connection string.
# Use the CONNECTION POOLER string, NOT the direct one:
#   Supabase → Project Settings → Database → Connection string → "Session pooler"
# The direct host (db.<ref>.supabase.co) is IPv6-only and most API hosts
# (Render/Railway free tiers) are IPv4, so use the pooler host below.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Store name — a matching row is auto-created in `stores` on first request.
STORE_NAME=SliceMatic Delhi

# CORS: comma-separated origins allowed to call the API.
# Local dev: defaults below. Production: add your Vercel app origin, e.g.
#   ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- COO chatbot (OpenRouter) ----------------------------------------------
# Get a key at https://openrouter.ai/keys — never commit the real value.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model slug from https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional — shown on OpenRouter usage dashboards (use Vercel URL in production)
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SliceMatic COO

# Analytics window embedded in each chat reply (days)
CHAT_CONTEXT_DAYS=7
CHAT_MAX_HISTORY=10
# Model slugs (optional overrides)
COO_BRIEF_MODEL=google/gemini-2.5-flash
COO_CHAT_MODEL=google/gemini-2.5-flash

# Read-only DB URL for COO chat SQL execution (defaults to DATABASE_URL)
# COO_DATABASE_URL=postgresql://coo_readonly:coo_readonly_dev@localhost:5432/slicematic

